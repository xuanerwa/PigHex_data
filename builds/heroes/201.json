{"schemaVersion": 3, "hero": {"id": 201, "slug": "braum", "riotId": "Braum", "name": "布隆", "title": "弗雷尔卓德之心", "aliases": ["布隆", "弗雷尔卓德之心", "Braum", "bu", "bulong", "fuleierzhuodezhixin"], "roles": ["Tank", "Support"], "icon": "assets/champions/braum.2fb931ec1ba5.webp", "abilities": [{"key": "Q", "name": "寒冬之咬", "description": "布隆驱动盾牌中的冷冻冰块，对敌人造成魔法伤害和减速效果。<br><br>对目标施加一层<font color='#FFF673'>震荡猛击</font>。", "icon": "assets/resources/abilities/Braum-Q.0dc250406abd.webp"}, {"key": "E", "name": "坚不可摧", "description": "布隆朝一个方向举起盾牌，持续数秒，可以拦截所有敌方飞行道具，并将它们摧毁，但自身要承受这些飞行道具的伤害。在举盾后，布隆将使承受的第一次攻击变得完全无效，并降低来自这个方向的所有后续攻击的伤害。", "icon": "assets/resources/abilities/Braum-E.4ce59980b6f4.webp"}, {"key": "W", "name": "挺身而出", "description": "布隆跃向目标友军英雄或小兵。在抵达时，布隆和友军会暂时获得护甲和魔法抗性加成。", "icon": "assets/resources/abilities/Braum-W.3fafea216508.webp"}]}, "ranking": {"id": 201, "rank": 123, "tier": "C", "sampleCount": 30358, "winRate": 0.4804, "pickRate": 0.0164, "blueWinRate": 0.5101, "redWinRate": 0.4507, "winRatePercent": 48.04, "pickRatePercent": 1.64}, "build": {"key": "tank", "name": "坦克流", "sampleCount": 10914, "lowSampleWarning": false, "pickRate": 0.4876, "winRate": 0.4753, "coreProfile": {"sampleCount": 870, "pickRate": 0.0797, "winRate": 0.4897, "itemIds": [3084, 3083, 6665], "selectionMinPickRate": 0.05}, "starter": {"sampleCount": 501, "pickRate": 0.7422, "winRate": 0.489}, "skillOrder": "Q>E>W"}, "defaultBuildKey": "tank", "builds": [{"key": "tank", "name": "坦克流", "sampleCount": 10914, "lowSampleWarning": false, "pickRate": 0.4876, "winRate": 0.4753, "coreProfile": {"sampleCount": 870, "pickRate": 0.0797, "winRate": 0.4897, "itemIds": [3084, 3083, 6665], "selectionMinPickRate": 0.05}, "starter": {"sampleCount": 501, "pickRate": 0.7422, "winRate": 0.489}, "skillOrder": "Q>E>W", "items": {"starter": [{"id": 1011, "name": "巨人腰带", "icon": "assets/resources/items/1011.47a3899b421b.webp"}, {"id": 1028, "name": "红水晶", "icon": "assets/resources/items/1028.3163a1cf6cd6.webp"}], "core": [{"