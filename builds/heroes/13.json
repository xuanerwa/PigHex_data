{"schemaVersion": 3, "hero": {"id": 13, "slug": "ryze", "riotId": "Ryze", "name": "瑞兹", "title": "符文法师", "aliases": ["瑞兹", "符文法师", "Ryze", "rui", "流浪", "liulang", "ruizi", "fuwenfashi"], "roles": ["Mage"], "icon": "assets/champions/ryze.b3203217d3e6.webp", "abilities": [{"key": "Q", "name": "超负荷", "description": "被动部分：瑞兹的其它基础技能会重置【超负荷】的冷却时间并且充能一层符文。当瑞兹带着2层符文施放【超负荷】时，他会获得短暂的爆发性移动速度加成。<br><br>施放时，瑞兹会沿直线扔出一团纯粹能量，来对命中的第一个敌人造成伤害。如果目标身上有【涌动】效果，那么【超负荷】会造成额外伤害并弹射至附近带有【涌动】效果的敌人身上。", "icon": "assets/resources/abilities/Ryze-Q.a4474f07b77f.webp"}, {"key": "E", "name": "法术涌动", "description": "瑞兹放出一颗纯净魔法能量球，对一名敌人造成伤害并对附近的敌人造成减益效果。瑞兹的技能可以对带有该减益的敌人造成额外效果。", "icon": "assets/resources/abilities/Ryze-E.f49f47901115.webp"}, {"key": "W", "name": "符文禁锢", "description": "瑞兹将一个目标陷入一个符文牢笼中，来对其造成伤害和减速效果。如果目标身上带有【涌动】效果，那么减速效果会替换为禁锢效果。", "icon": "assets/resources/abilities/Ryze-W.5970b65922c1.webp"}]}, "ranking": {"id": 13, "rank": 36, "tier": "A", "sampleCount": 460683, "winRate": 0.5183, "pickRate": 0.1072, "blueWinRate": 0.5428, "redWinRate": 0.4938, "winRatePercent": 51.83, "pickRatePercent": 10.72}, "build": {"key": "ap", "name": "法术流", "sampleCount": 367660, "lowSampleWarning": false, "pickRate": 0.9431, "winRate": 0.5213, "coreProfile": {"sampleCount": 125683, "pickRate": 0.3418, "winRate": 0.5352, "itemIds": [6657, 3003, 3089], "selectionMinPickRate": 0.05}, "starter": {"sampleCount": 4961, "pickRate": 0.0434, "winRate": 0.5503}, "skillOrder": "Q>E>W"}, "defaultBuildKey": "ap", "builds": [{"key": "ap", "name": "法术流", "sampleCount": 367660, "lowSampleWarning": false, "pickRate": 0.9431, "winRate": 0.5213, "coreProfile": {"sampleCount": 125683, "pickRate": 0.3418, "winRate": 0.5352, "itemIds": [6657, 3003, 3089], "selectionMinPickRate": 0.05}, "starter": {"sampleCount": 4961, "pickRate": 0.0434, "winRate": 0.5503}, "skillOrder": "Q>E>W", "items": {"starter": [{"id": 1028, "name": "红水晶", "icon": "assets/resources/items/1028.3163a1cf6cd6.webp"}, {"id": 1028, "name": "红水晶", "icon": "assets