{"schemaVersion": 3, "hero": {"id": 143, "slug": "zyra", "riotId": "Zyra", "name": "婕拉", "title": "荆棘之兴", "aliases": ["婕拉", "荆棘之兴", "Zyra", "jiela", "jingjizhixing"], "roles": ["Mage", "Support"], "icon": "assets/champions/zyra.106980febe2f.webp", "abilities": [{"key": "Q", "name": "致命棘刺", "description": "浓密的藤蔓在地面蔓延，并爆炸成棘刺，对范围内的敌人造成魔法伤害。如果在一颗种子附近施放，那么【Q致命棘刺】就会让种子长成一株荆棘喷射者，可对远处的敌人进行攻击。", "icon": "assets/resources/abilities/Zyra-Q.f017ee6e6f56.webp"}, {"key": "W", "name": "狂野生长", "description": "婕拉播下一颗种子，最多持续60秒。在种子附近施放【Q致命棘刺】或【E缠绕之根】会让种子长成植物，与婕拉并肩作战。婕拉可以同时存有多个种子，并且击杀敌人会减少【W狂野生长】的充能时间。", "icon": "assets/resources/abilities/Zyra-W.0d5707ff37ca.webp"}, {"key": "E", "name": "缠绕之根", "description": "婕拉朝前方放出贯穿地面的藤蔓来诱捕她的目标，藤蔓经过的敌人会受到伤害和束缚效果。如果在一颗种子附近施放，那么【E缠绕之根】就会让种子长成一株藤蔓鞭击者，可进行短程攻击并降低敌人的移动速度。", "icon": "assets/resources/abilities/Zyra-E.567b4c7278e7.webp"}]}, "ranking": {"id": 143, "rank": 68, "tier": "B", "sampleCount": 181636, "winRate": 0.5028, "pickRate": 0.0423, "blueWinRate": 0.5321, "redWinRate": 0.4739, "winRatePercent": 50.28, "pickRatePercent": 4.23}, "build": {"key": "ap", "name": "法术流", "sampleCount": 129602, "lowSampleWarning": false, "pickRate": 0.873, "winRate": 0.4932, "coreProfile": {"sampleCount": 79456, "pickRate": 0.6131, "winRate": 0.4949, "itemIds": [2503, 6653, 3116], "selectionMinPickRate": 0.05}, "starter": {"sampleCount": 25950, "pickRate": 0.5946, "winRate": 0.4956}, "skillOrder": "Q>W>E"}, "defaultBuildKey": "ap", "builds": [{"key": "ap", "name": "法术流", "sampleCount": 129602, "lowSampleWarning": false, "pickRate": 0.873, "winRate": 0.4932, "coreProfile": {"sampleCount": 79456, "pickRate": 0.6131, "winRate": 0.4949, "itemIds": [2503, 6653, 3116], "selectionMinPickRate": 0.05}, "starter": {"sampleCount": 25950, "pickRate": 0.5946, "winRate": 0.4956}, "skillOrder": "Q>W>E", "items": {"starter": [{"id": 3802, "name": "遗失的章节", "icon": "assets/resources/items/3802.cbfa17bc3d75.webp"}], "core": [{"id": 2503, "name": "黯炎火炬", "sampleCount": 79456, "pickR