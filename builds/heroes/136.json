{"schemaVersion": 3, "hero": {"id": 136, "slug": "aurelionsol", "riotId": "AurelionSol", "name": "奥瑞利安·索尔", "title": "铸星龙王", "aliases": ["奥瑞利安·索尔", "铸星龙王", "AurelionSol", "龙王", "long", "aoruiliansuoer", "zhuxinglongwang", "longwang"], "roles": ["Mage"], "icon": "assets/champions/aurelionsol.374839ea5a4d.webp", "abilities": [{"key": "Q", "name": "星河冲荡", "description": "奥瑞利安·索尔引导他的龙息若干秒，伤害首个命中的敌人并对附近的敌人们造成削减过的溅射伤害。龙息在一个敌人身上每直接引导一秒就会造成额外伤害，这个伤害可通过已收集的【星尘】来提升。如果目标是一名英雄，那么这个技能还会收集【星尘】。", "icon": "assets/resources/abilities/AurelionSol-Q.f8feb2d0d2d7.webp"}, {"key": "E", "name": "星芒凝汇", "description": "奥瑞利安·索尔召唤一个黑洞，对敌人们造成伤害并缓慢地将他们拉拽向黑洞的中心。每有一名敌人在黑洞中阵亡，以及一名敌方英雄在黑洞中每被困住一秒，这个技能都会提供【星尘】。黑洞的中心会处决低于一定百分比最大生命值的敌人。【星尘】会提升【星芒凝汇】的区域以及处决阈值。", "icon": "assets/resources/abilities/AurelionSol-E.0d07d64b03a7.webp"}, {"key": "W", "name": "星穹流丽", "description": "奥瑞利安 · 索尔沿着目标方向飞越地形。在这个状态下，他可以施放其它技能。飞行期间，星河冲荡没有冷却时间，也没有最长蓄力时间，并且造成的伤害会提升。<br><br>如果有敌方英雄因为奥瑞利安 · 索尔近期造成的伤害阵亡，星穹流丽的冷却时间会缩短。<br><br>星尘会提升星穹流丽的最大飞行距离。", "icon": "assets/resources/abilities/AurelionSol-W.008db2105ee6.webp"}]}, "ranking": {"id": 136, "rank": 115, "tier": "B", "sampleCount": 200784, "winRate": 0.4817, "pickRate": 0.1082, "blueWinRate": 0.5112, "redWinRate": 0.4521, "winRatePercent": 48.17, "pickRatePercent": 10.82}, "build": {"key": "ap", "name": "法术流", "sampleCount": 153985, "lowSampleWarning": false, "pickRate": 0.8806, "winRate": 0.4867, "coreProfile": {"sampleCount": 9591, "pickRate": 0.0623, "winRate": 0.5228, "itemIds": [3116, 6653, 8010], "selectionMinPickRate": 0.05}, "starter": {"sampleCount": 3605, "pickRate": 0.4112, "winRate": 0.5237}, "skillOrder": "Q>E>W"}, "defaultBuildKey": "ap", "builds": [{"key": "ap", "name": "法术流", "sampleCount": 153985, "lowSampleWarning": false, "pickRate": 0.8806, "winRate": 0.4867, "coreProfile": {"sampleCount": 9591, "pickRate": 0.0623, "winRate": 0.5228, "itemIds": [3116, 6653, 8010], "selectionMinPickRate": 0.05}, "starter": {"sampleCount": 3605, "pickRate": 0.4112, "winRate